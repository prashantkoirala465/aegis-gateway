# Copy to .env for local development. Never commit the real .env (gitignored).

ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres — app runs as the non-superuser aegis_app role so Row-Level Security
# policies are actually enforced (superusers bypass RLS unconditionally). This role
# is created by migration 0001, so migrations must run once (as the owner role below)
# before the app can start.
DATABASE_URL=postgresql+asyncpg://aegis_app:aegis_app@localhost:5432/aegis_gateway

# Table-owner connection, used only by `alembic upgrade` (needs DDL/CREATE ROLE rights
# the runtime aegis_app role deliberately lacks).
MIGRATION_DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5432/aegis_gateway

# Redis
REDIS_URL=redis://localhost:6379/0

# API-key hashing pepper (server-side secret, NOT stored in DB).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY_PEPPER=changeme-generate-a-real-32-byte-hex-secret

# Admin JWT signing secret.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-generate-a-real-32-byte-hex-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Upstream provider credentials (only needed once Phase 2 proxy is exercised)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
